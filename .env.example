# Medix Healthcare Portal - Email Configuration
# Optional: To enable live SMTP delivery via Nodemailer, copy this file to .env and provide your details.
# If omitted or left blank, the system automatically uses "Evaluation Demo Mode" with local outbox logs.

PORT=5000
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_hospital_demo_account@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM="Medix Healthcare" <your_hospital_demo_account@gmail.com>
